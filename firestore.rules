rules_version = '2';

// Regras do Firestore do projeto Dellalio (Cérebro, Gerenciador e app de
// clientes usam o mesmo banco).
//
// Em 2026-10-20 as regras publicadas eram totalmente abertas
// (`allow read, write: if true`). Esta versão mantém esse acesso para não
// quebrar nenhum dos apps e só acrescenta o que o estoque exige: o histórico
// de `movimentacoes` é imutável (cria, nunca edita nem apaga).
//
// PENDENTE (decisão do dono): fechar o banco para usuários autenticados.
// Antes, conferir se o app de clientes lê algo antes do login (site_content,
// vitrine) — se ler, essas coleções precisam continuar com leitura pública.
service cloud.firestore {
  match /databases/{database}/documents {

    match /movimentacoes/{id} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // Regras se somam (qualquer `allow` que case libera), então a exceção de
    // `movimentacoes` precisa ficar aqui também.
    match /{colecao}/{documento=**} {
      allow read: if true;
      allow write: if colecao != 'movimentacoes';
    }
  }
}
